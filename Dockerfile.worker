# Stage 1: Dependencies
# Use Debian-based image — Playwright needs system libs unavailable on Alpine
FROM node:22-slim AS deps
WORKDIR /app

COPY app/package.json app/package-lock.json ./

# Skip postinstall (playwright install) — we run it manually below
# Include optional native packages for cross-platform deterministic installs.
RUN npm install --include=optional --ignore-scripts

# Apply patches (e.g. GramJS TL schema fix) before building
COPY app/patches ./patches
RUN npx patch-package

# Rebuild sqlite3 native bindings (skipped by --ignore-scripts above)
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && npm rebuild sqlite3 \
    && apt-get purge -y python3 make g++ && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Place Playwright browsers in a shared, world-readable path so any
# runtime user (e.g. `worker` in the runner stage) can access them.
# Default install path is $HOME/.cache/ms-playwright which is /root/.cache/...
# in this stage and unreadable by non-root users in the runtime stage.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Install Chromium + system dependencies
RUN npx playwright install chromium --with-deps

# Stage 2: Build worker bundles with esbuild
FROM node:22-slim AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY app/ ./

# Bundle workers into JS files.
# --conditions=react-server: makes server-only resolve to empty module,
# so loggerServer, tracer, supabaseAdmin etc. work fine outside Next.js.
# --external:playwright: keep playwright as a runtime require (native binaries).
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN node_modules/.bin/esbuild worker/index.ts worker/hh.ts worker/engHiring.ts worker/search.ts worker/enrich.ts worker/enrichCoordinator.ts worker/yandexmaps.ts worker/googleparsers.ts worker/runner.ts worker/emailvalidation.ts worker/tgOutreach.ts worker/salesCopilot.ts worker/salesChatLogger.ts worker/salesChatArchive.ts worker/aiCaller.ts worker/tgParser.ts worker/tgTranscribe.ts worker/tgTranscribeAutoSyncCron.ts worker/instantlyLeads.ts worker/outreach.ts worker/liOutreach.ts worker/baseConstructor.ts worker/clientReportExports.ts worker/outreachosCron.ts worker/autoPipelineCron.ts worker/autoPipeline.ts worker/bobBackgroundScorer.ts worker/manualScoringWorker.ts worker/autoRenewCron.ts worker/salesAiAnalysis.ts worker/salesAiAnalysisCron.ts worker/byoSend.ts worker/byoReplies.ts worker/leadsReportCron.ts worker/leadsReportBot.ts worker/leadsReportSummaryCron.ts worker/hypothesisEngine.ts worker/heAutoPipelineCron.ts worker/jobhiveIngestCron.ts worker/gisSignalOutreachCron.ts \
  --bundle \
  --platform=node \
  --target=node22 \
  --outdir=dist/workers \
  --tsconfig=tsconfig.json \
  --conditions=react-server \
  --external:playwright \
  --external:sqlite3 \
  --external:gramjs-sqlitesession \
  --log-level=info

# Stage 3: Runtime
FROM node:22-slim AS runner
WORKDIR /app

RUN groupadd --gid 1001 nodejs && useradd --uid 1001 --gid 1001 --create-home worker

# Match deps stage so Playwright runtime resolves browsers from the same path
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Copy Playwright browser cache from deps stage and ensure world read+exec
COPY --from=deps /ms-playwright /ms-playwright
RUN chmod -R a+rX /ms-playwright

# ffmpeg for audio/video extraction (transcription workers)
# curl for the ATS parser's domain enrichment (Clearbit's WAF 403s node/undici
# by TLS fingerprint, but lets curl through — see lib/parsers/atsRunner.ts)
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates unzip \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# DuckDB CLI for the jobhive bulk-feed ingest (worker/jobhiveIngestCron.ts streams
# the remote parquet via httpfs). Single binary, same install as scripts/pdl/README.
RUN curl -fsSL https://github.com/duckdb/duckdb/releases/latest/download/duckdb_cli-linux-amd64.zip -o /tmp/duckdb.zip \
    && unzip -o /tmp/duckdb.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/duckdb \
    && rm /tmp/duckdb.zip

# Install only Playwright system libraries (no browser download)
RUN npx playwright install-deps chromium

# Runtime node_modules (for Playwright native modules)
COPY --from=deps /app/node_modules ./node_modules

# Compiled worker bundles
COPY --from=builder /app/dist/workers ./workers

USER worker

ENV WORKER_KIND=all
CMD ["node", "workers/runner.js"]

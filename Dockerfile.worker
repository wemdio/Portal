# Stage 1: Dependencies
# Use Debian-based image — Playwright needs system libs unavailable on Alpine
FROM node:20-slim AS deps
WORKDIR /app

COPY app/package.json app/package-lock.json ./

# Skip postinstall (playwright install) — we run it manually below
# Include optional native packages for cross-platform deterministic installs.
RUN npm ci --include=optional --ignore-scripts

# Install Chromium + system dependencies
RUN npx playwright install chromium --with-deps

# Stage 2: Build worker bundles with esbuild
FROM node:20-slim AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY app/ ./

# Bundle workers into JS files.
# --conditions=react-server: makes server-only resolve to empty module,
# so loggerServer, tracer, supabaseAdmin etc. work fine outside Next.js.
# --external:playwright: keep playwright as a runtime require (native binaries).
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN node_modules/.bin/esbuild worker/index.ts worker/hh.ts worker/search.ts worker/enrich.ts worker/yandexmaps.ts worker/runner.ts worker/emailvalidation.ts worker/tgOutreach.ts \
  --bundle \
  --platform=node \
  --target=node20 \
  --outdir=dist/workers \
  --tsconfig=tsconfig.json \
  --conditions=react-server \
  --external:playwright \
  --log-level=info

# Stage 3: Runtime
FROM node:20-slim AS runner
WORKDIR /app

RUN groupadd --gid 1001 nodejs && useradd --uid 1001 --gid 1001 worker

# Copy Playwright browser cache from deps stage
COPY --from=deps /root/.cache/ms-playwright /root/.cache/ms-playwright

# Install only Playwright system libraries (no browser download)
RUN npx playwright install-deps chromium

# Runtime node_modules (for Playwright native modules)
COPY --from=deps /app/node_modules ./node_modules

# Compiled worker bundles
COPY --from=builder /app/dist/workers ./workers

USER worker

ENV WORKER_KIND=all
CMD ["node", "workers/runner.js"]

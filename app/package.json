{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "playwright install chromium",
    "db:migrate": "node scripts/db/ensureDatabase.js",
    "predev": "node scripts/db/ensureDatabase.js && node scripts/ensureTgBotApi.js",
    "dev": "concurrently \"next dev\" \"cd ../services/yandexmaps && uvicorn server:app --reload --port 8010\" \"npm run dev:workers\"",
    "dev:next": "next dev",
    "dev:workers": "concurrently \"npm run build:workers:watch\" \"node --watch --env-file ../.env dist/workers/hh.js\" \"node --watch --env-file ../.env dist/workers/search.js\" \"node --watch --env-file ../.env dist/workers/enrich.js\" \"node --watch --env-file ../.env dist/workers/yandexmaps.js\" \"node --watch --env-file ../.env dist/workers/emailvalidation.js\" \"node --watch --env-file ../.env dist/workers/tgOutreach.js\"",
    "build": "next build",
    "dev:worker": "concurrently \"npm run build:worker:watch\" \"node --watch --env-file ../.env dist/worker.js\"",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node20 --outfile=dist/worker.js --tsconfig=tsconfig.json --conditions=react-server --external:playwright --log-level=info",
    "build:worker:watch": "esbuild worker/index.ts --bundle --platform=node --target=node20 --outfile=dist/worker.js --tsconfig=tsconfig.json --conditions=react-server --external:playwright --log-level=info --watch",
    "build:workers": "esbuild worker/index.ts worker/hh.ts worker/search.ts worker/enrich.ts worker/yandexmaps.ts worker/runner.ts worker/emailvalidation.ts worker/tgOutreach.ts --bundle --platform=node --target=node20 --outdir=dist/workers --tsconfig=tsconfig.json --conditions=react-server --external:playwright --log-level=info",
    "build:workers:watch": "esbuild worker/index.ts worker/hh.ts worker/search.ts worker/enrich.ts worker/yandexmaps.ts worker/runner.ts worker/emailvalidation.ts worker/tgOutreach.ts --bundle --platform=node --target=node20 --outdir=dist/workers --tsconfig=tsconfig.json --conditions=react-server --external:playwright --log-level=info --watch",
    "prestart": "node scripts/db/ensureDatabase.js",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "bench:parsers": "node --env-file ../.env scripts/bench/parsersBench.js",
    "docker:rdp": "docker compose -f ../docker-compose.rdp.yml up --build",
    "docker:rdp:down": "docker compose -f ../docker-compose.rdp.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.5",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@thednp/dommatrix": "^3.0.2",
    "@tiptap/extension-bullet-list": "^3.20.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-font-family": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-list-item": "^3.20.0",
    "@tiptap/extension-ordered-list": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/html": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/file-saver": "^2.0.7",
    "@types/papaparse": "^5.5.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.2",
    "docx": "^9.5.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "file-saver": "^2.0.5",
    "googleapis": "^144.0.0",
    "gramjs-sqlitesession": "^1.1.1",
    "guacamole-common-js": "^1.5.0",
    "iconv-lite": "^0.7.2",
    "linkedin-private-api": "^1.1.2",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "playwright": "^1.58.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "telegram": "^2.26.22",
    "tg-file-id": "^1.1.2",
    "undici": "^7.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/dockerode": "^4.0.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "^1.31.1"
  }
}

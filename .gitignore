# dependencies
app/node_modules
app/.pnp
app/.pnp.*
app/.yarn/*
!app/.yarn/patches
!app/.yarn/plugins
!app/.yarn/releases
!app/.yarn/versions

regl.docx
companies_5000.xlsx
companies_10000.xlsx
.cursor
.github/


# next.js
app/.next/
app/out/

# production
app/build
app/dist/

# misc
.DS_Store
*.pem
# Исключение ровно на один файл, а не на каталог: это ПУБЛИЧНЫЙ корневой
# сертификат УЦ Минцифры (без него не открыть соединение с Точкой), а не ключ.
# Правило `*.pem` выше намеренно оставлено широким — приватный ключ, случайно
# положенный рядом, по-прежнему в коммит не попадёт.
!services/portal-external-sync/certs/russian_trusted_root_ca.pem
app/npm-debug.log*
app/yarn-debug.log*
app/yarn-error.log*
app/.pnpm-debug.log*

# env files (NEVER commit these in a real project, but for now we have hardcoded keys in code anyway)
app/.env*
app/env.local
.env.local
.env
.env.servers

# vercel
app/.vercel

# typescript
app/*.tsbuildinfo
app/next-env.d.ts

# docs
docs/*.xlsx

.cursorrules

# doc env files with credentials
doc_*.env
*.env.bak

# Локальные исходники брифов/офферов заказчика. Эталонные .txt-версии для
# инструмента «Цепочки писем 2.0» лежат в S3 (MAIN_S3_BUCKET под
# tools/email-sequence-v2/reference/...), сами PDF/DOCX в репо не нужны.
offers_example/

# python
**/__pycache__/
*.py[cod]

# Сторонние сервисы (smtp-proxy, и т.п.) — node_modules восстанавливается через npm install,
# dist собирается через npm run build, нет смысла хранить их в репозитории.
services/*/node_modules/
services/*/dist/

# Большие тестовые наборы данных (не нужны в истории — лежат в S3 / лок-окружении).
app/public/test60k.csv

# Локальные временные данные / клиентские артефакты — нельзя хранить в публичной git-истории
# (могут содержать персональные данные, реквизиты, контракты).
.tmp/
_fix_tmp/
temp_bank/
temp-cases/
temp-transcripts/
temp-diarize/

# Локальные SQL-разделения — генерируются скриптами, не нужны в репо.
app/.sql-chunks/
app/sql_splits/

# Временные файлы в корне `app/` (генерируются скриптами поэтапной заливки).
app/temp_*

# Одноразовые fix/update/write-скрипты в корне репо — оставляем у разработчика локально.
/fix_*.py
/update_*.py
/write_config.py

# Конфиги локальных AI-инструментов — у каждого разработчика свои.
.augment/
.agents/
.claude/

# Архивы скачиваний и прочие результаты — не должны попадать в репо.
New folder/
*personal_*months*.json
*hh_results_*.csv
*personalization-test-results.csv

# Локальный proxy-монитор — debug-скрипт и его выгрузки результатов,
# не нужны в общей истории.
/scripts/proxy_monitor.py
/proxy_monitor_results/

# Локальные диагностические/debug-скрипты в корне репо (`_check_*`, `_prod_*`,
# `_extract_*`, `_deploy_*` и т.п.). Это инструменты разработчика для разовых
# проверок продакшена / отладки, не должны попадать в общую историю.
/_*.py
/_*.mjs
/_*.html
/_*.json
/_*.txt
/_*.cjs

# Тестовые скрипты в `app/scripts/` — одноразовые проверки API (test-inn-*,
# test-requesty-*) и пакетные загрузки (upload-3-*, upload-transcripts-*).
app/scripts/test-inn-*.*
app/scripts/test-requesty-*.*
app/scripts/upload-3-*.*
app/scripts/upload-transcripts-*.*
# Префиксованные underscore-скрипты в `app/scripts/` — debug/одноразовые.
app/scripts/_*.mjs
app/scripts/_*.ts
app/scripts/_*.cjs

# Локальные mcp/sql/payload-артефакты в `app/`.
app/.invoke-*.json
app/.mcp-*.json
app/.mcp_*.json
app/.split-*.mjs
app/.dump-*.mjs
app/.term-out-*.txt
app/_test_*.mjs
app/payload_batch_*.json

# Корневые underscore-результаты разовых анализов.
/_*.csv
/_*.tsx
/_*.ts

# Все Python-скрипты в корне репо — это разовые dev-инструменты (check_*, clean_*,
# diag*, debug_*, fix_*, install_*, get_*, restore_*, setup-* и т.п.).
# Единственное исключение — `test_instantly_limit.py`, который реально нужен.
/*.py
!/test_instantly_limit.py


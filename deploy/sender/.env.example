# Воркер «Рассылки» на изолированном email-хосте (144.31.54.166).
# Копируй в /opt/portal-sender/.env и заполни. Секреты брать из .env портала.

# Docker Hub (тот же образ воркера, что и на портале)
DOCKER_USERNAME=

# Supabase основной БД портала (service role — воркер пишет очереди/статусы)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ключ AES-256-GCM для запечатывания паролей ящиков (совпадает с порталом)
BYO_MAILBOX_CRED_KEY=

# Необязательные тюнинги
# WORKER_POLL_INTERVAL_MS=5000
# SENDER_REPLIES_INTERVAL_MS=60000

# Воркеры «Рассылки» на изолированном email-хосте (144.31.54.166, 77.239.125.235, …).
# Копируй в /opt/portal-sender/.env и заполни. Секреты брать из .env портала.

# Docker Hub (тот же образ воркера, что и на портале)
DOCKER_USERNAME=

# Supabase основной БД портала (service role — воркер пишет очереди/статусы)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ключ AES-256-GCM для запечатывания паролей ящиков (совпадает с порталом)
BYO_MAILBOX_CRED_KEY=

# Адреса отправки ЭТОГО сервера через запятую: на каждый — свой воркер
# (render-compose.sh). Адрес должен быть поднят на интерфейсе сервера.
# Адреса проб почт (smtp-proxy) сюда не вписывать.
SENDER_EGRESS_IPS=
# Подпись сервера на экране «Адреса отправки» (обычно основной IP сервера)
SENDER_HOST_LABEL=

# Ящики Google Workspace без паролей (служебный аккаунт с делегированием)
# SENDER_GOOGLE_SA_EMAIL=
# SENDER_GOOGLE_SA_PRIVATE_KEY=
# Алерты монитора в Telegram (отправка встала, адрес молчит, bounce rate)
# SENDER_ALERTS_TELEGRAM_CHAT_ID=
# SENDER_ALERTS_TELEGRAM_BOT_TOKEN=

# Необязательные тюнинги
# SENDER_REPLIES_INTERVAL_MS=60000

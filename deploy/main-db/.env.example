# ══════════════════════════════════════════════════════════════════════════════
# Self-hosted Supabase для main Portal DB (deploy/main-db).
# Скопируй на DB-сервер: /opt/main-db/.env
#
# Пароль main-postgres (MAIN_PG_PASSWORD) дублируется в /opt/instantly-db/.env —
# убедись, что значения совпадают.
#
# Перед заполнением: сгенерируй JWT-ключи:
#   node deploy/main-db/scripts/generate-keys.mjs
# Если хочешь сохранить существующие сессии Supabase Cloud — передай старый секрет:
#   node scripts/generate-keys.mjs --secret=<JWT_SECRET_из_Supabase_Dashboard>
# ══════════════════════════════════════════════════════════════════════════════

# ─── Postgres (тот же пароль, что в /opt/instantly-db/.env → MAIN_PG_PASSWORD) ──
MAIN_PG_PASSWORD=CHANGE_ME

# ─── JWT (из generate-keys.mjs) ──────────────────────────────────────────────
MAIN_JWT_SECRET=CHANGE_ME_min_32_chars
MAIN_JWT_EXP=3600
MAIN_ANON_KEY=CHANGE_ME_jwt_token_role_anon
MAIN_SERVICE_ROLE_KEY=CHANGE_ME_jwt_token_role_service_role

# ─── Публичный URL стека (то, что видит Portal как NEXT_PUBLIC_SUPABASE_URL) ─
# Используем IP DB-сервера + порт Kong (по умолчанию 35480)
MAIN_API_EXTERNAL_URL=http://144.31.54.166:35480
MAIN_SITE_URL=https://portal.example.com
# Через запятую — куда GoTrue разрешает редиректить после входа
MAIN_ADDITIONAL_REDIRECT_URLS=https://portal.example.com/**,http://localhost:3000/**

# ─── Auth (GoTrue) ────────────────────────────────────────────────────────────
MAIN_DISABLE_SIGNUP=false
MAIN_ENABLE_EMAIL_SIGNUP=true
# true = пользователи активируются сразу (без письма-подтверждения).
# false = нужен SMTP, иначе invite/recovery не уйдут.
MAIN_ENABLE_EMAIL_AUTOCONFIRM=true

# SMTP для GoTrue (нужен только если MAIN_ENABLE_EMAIL_AUTOCONFIRM=false
# или ты хочешь, чтобы password-reset/invite-эмейлы реально отправлялись).
MAIN_SMTP_ADMIN_EMAIL=admin@portal.example.com
MAIN_SMTP_HOST=
MAIN_SMTP_PORT=587
MAIN_SMTP_USER=
MAIN_SMTP_PASS=
MAIN_SMTP_SENDER_NAME=Portal

# ─── PostgREST ────────────────────────────────────────────────────────────────
# Из каких схем PostgREST раздаёт REST API. По умолчанию public + storage + graphql_public.
MAIN_PGRST_DB_SCHEMAS=public,storage,graphql_public

# ─── Realtime ─────────────────────────────────────────────────────────────────
# 16 байт (alphanumeric). Нужно для шифрования секретов в realtime.
MAIN_REALTIME_DB_ENC_KEY=CHANGE_ME_16chars
# Минимум 64 случайных байта в base64.
MAIN_REALTIME_SECRET_KEY_BASE=CHANGE_ME_min_64_chars_base64

# ─── Storage ──────────────────────────────────────────────────────────────────
# Лимит загрузки одного файла, байты (по умолчанию 500 МБ).
MAIN_STORAGE_FILE_SIZE_LIMIT=524288000
MAIN_IMGPROXY_ENABLE_WEBP_DETECTION=true

# ─── Studio (web UI, доступен только через SSH-tunnel на 127.0.0.1:35413) ────
MAIN_DASHBOARD_USERNAME=supabase
MAIN_DASHBOARD_PASSWORD=CHANGE_ME
MAIN_STUDIO_ORGANIZATION_NAME=Portal
MAIN_STUDIO_PROJECT_NAME=Default Project

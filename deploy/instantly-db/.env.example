# ══════════════════════════════════════════════════════════════════════════════
# ВАЖНО: здесь две разные «корзины» переменных — не путай.
#
# 1) Файл .env НА СЕРВЕРЕ БД (например /opt/instantly-db/.env)
#    → только блок «A. Сервер БД» ниже. Его читает docker compose на этой машине.
#
# 2) Semaphore (секреты / Environment для pipeline «Scheduled Deploy»)
#    → только блок «B. Semaphore». В серверный .env их НЕ кладут.
#
# 3) Сервер Portal (/home/Portal/prod/.env)
#    → там свои переменные приложения: INSTANTLY_DATABASE_URL на IP:35432 этого
#      сервера, INSTANTLY_SUPABASE_URL на PostgREST :35401 и т.д. (см. комментарии в основном проекте).
# ══════════════════════════════════════════════════════════════════════════════

# ─── A. Сервер БД — скопируй этот блок в .env на машине, где крутится deploy/instantly-db ───
# Порты на хосте: prod PG 35432, PostgREST 35401, pgAdmin 127.0.0.1:35410;
#                 dev  PG 35433, PostgREST 35402, pgAdmin 127.0.0.1:35411

# Prod Postgres / PostgREST / pgAdmin
INSTANTLY_PROD_PG_PASSWORD=CHANGE_ME
INSTANTLY_PROD_JWT_SECRET=CHANGE_ME
INSTANTLY_PROD_PGADMIN_EMAIL=admin@portal.local
INSTANTLY_PROD_PGADMIN_PASSWORD=CHANGE_ME

# Dev Postgres / PostgREST / pgAdmin
INSTANTLY_DEV_PG_PASSWORD=CHANGE_ME
INSTANTLY_DEV_JWT_SECRET=CHANGE_ME
INSTANTLY_DEV_PGADMIN_EMAIL=admin@portal.local
INSTANTLY_DEV_PGADMIN_PASSWORD=CHANGE_ME

# Main Portal Postgres (порт 35434 на хосте)
MAIN_PG_PASSWORD=CHANGE_ME
MAIN_PGADMIN_EMAIL=admin@portal.com
MAIN_PGADMIN_PASSWORD=CHANGE_ME

# Бэкапы pg_dump → Supabase Storage (часто тот же проект, что у Portal).
# В Storage должен существовать bucket deploy-backups (путь загрузки: deploy-backups/...).
# Ключ: Settings → API → service_role (не anon).
BACKUP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
BACKUP_SUPABASE_KEY=service_role_secret_from_dashboard
# Сколько дней держать локальные .dump в контейнере; на объекты в облаке не влияет.
BACKUP_RETENTION_DAYS=7

# ─── B. Semaphore — НЕ часть серверного .env; завести в UI Semaphore (Secrets / Env) ───
#
# INSTANTLY_DB_SSH_HOST
#   IP или hostname сервера из блока A. Если пусто — CI не трогает БД, только Portal.
#
# INSTANTLY_DB_SSH_USER   (необязательно)
#   Логин SSH на сервер БД. Не задан → берётся тот же USER, что и для деплоя Portal.
#
# INSTANTLY_DB_SSH_PASSWORD   (необязательно)
#   Пароль SSH. Не задан → берётся SERVER_PASSWORD (как у Portal).
#
# INSTANTLY_DB_REMOTE_DIR   (необязательно)
#   Каталог на сервере БД, куда CI кладёт compose и миграции. По умолчанию: /opt/instantly-db
#
# INSTANTLY_SOURCE_DB_URL   (только для первого переноса данных из Supabase)
#   Строка подключения к старой БД Supabase (обычно pooler :6543). После успешного импорта
#   лучше удалить из Semaphore. Пока задано и нет файла .supabase_import_done на сервере —
#   при деплое один раз запустится migrate-instantly-to-local-pg.mjs.
#
# INSTANTLY_FORCE_SUPABASE_IMPORT=1   (редко)
#   Перед импортом снимает маркер .supabase_import_done на сервере БД, чтобы повторить копирование.

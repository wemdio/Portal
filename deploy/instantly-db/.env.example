# ──────────────────────────────────────────────────────────────────────────────
# Instantly DB server — environment variables
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────────────────────────────────────
#
# Host ports (see docker-compose.yml): prod PG 35432, PostgREST 35401, pgAdmin 35410;
# dev PG 35433, PostgREST 35402, pgAdmin 35411. Portal .env: use these ports in
# INSTANTLY_DATABASE_URL and INSTANTLY_SUPABASE_URL when connecting by server IP.

# ─── Prod instance ───────────────────────────────────────────────────────────
INSTANTLY_PROD_PG_PASSWORD=CHANGE_ME
INSTANTLY_PROD_JWT_SECRET=CHANGE_ME
INSTANTLY_PROD_PGADMIN_EMAIL=admin@portal.local
INSTANTLY_PROD_PGADMIN_PASSWORD=CHANGE_ME

# ─── Dev instance ────────────────────────────────────────────────────────────
INSTANTLY_DEV_PG_PASSWORD=CHANGE_ME
INSTANTLY_DEV_JWT_SECRET=CHANGE_ME
INSTANTLY_DEV_PGADMIN_EMAIL=admin@portal.local
INSTANTLY_DEV_PGADMIN_PASSWORD=CHANGE_ME

# ─── Backups (Supabase Storage) ──────────────────────────────────────────────
# URL and service-role key of the Supabase project used for storing backups.
BACKUP_SUPABASE_URL=https://gngsfwkvnrddfwhpqopr.supabase.co
BACKUP_SUPABASE_KEY=CHANGE_ME

# How many days to keep local backup files before deleting (default: 7)
BACKUP_RETENTION_DAYS=7

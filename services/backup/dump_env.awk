# Печатает текущее окружение в виде:
#   export KEY='VALUE'
# где одинарные кавычки в VALUE экранированы как '\''
#
# Используется /entrypoint.sh для снапшота env контейнера в /etc/backup.env,
# чтобы cron-job получил актуальный набор переменных независимо от того,
# какой environ был у crond на момент старта.
#
# Не пишет переменные с не-shell-совместимыми именами (напр. содержащие '.').

BEGIN {
  q = "\047"               # одинарная кавычка
  esc = q "\\" q q         # последовательность '\'' для экранирования внутри '...'
  for (k in ENVIRON) {
    if (k !~ /^[A-Za-z_][A-Za-z0-9_]*$/) continue
    v = ENVIRON[k]
    gsub(q, esc, v)
    printf "export %s=%s%s%s\n", k, q, v, q
  }
}

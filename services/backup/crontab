# Cron schedule для контейнера portal-backup.
# Все времена UTC (МСК = UTC+3).
#
# Расписание: 3 раза в день — 09:00, 15:00, 21:00 МСК.
# Ротация: 7 дней × 3 = 21 снэпшот на БД. При ~840 МБ дампе main это ~18 ГБ.
#
# ВАЖНО: каждая команда оборачивается в `sh -c`, который сначала подгружает
# /etc/backup.env (env-снапшот, который пишет /entrypoint.sh при старте
# контейнера). Без этого BusyBox crond передаёт ребёнку пустой env, и
# /backup.sh уходит в S3 без BACKUP_S3_*/MAIN_S3_* — что даёт rc=1 без
# понятной причины. См. services/backup/entrypoint.sh.

# Главная Supabase БД (portal-main): 06:00 / 12:00 / 18:00 UTC
0 6,12,18 * * * sh -c '. /etc/backup.env; /backup.sh main-supabase' >> /var/log/cron.log 2>&1

# Instantly local Postgres prod: 06:15 / 12:15 / 18:15 UTC (сдвиг 15 мин)
15 6,12,18 * * * sh -c '. /etc/backup.env; /backup.sh instantly-prod' >> /var/log/cron.log 2>&1
